# LaunchPad OS — Root Frontend Environment Configuration Template

# Next.js Application Environment Mode (development | staging | production)
NODE_ENV=development

# Next.js Server Port
PORT=3000

# Public API Gateway Base URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Telemetry & Analytics Toggle (0 = enabled, 1 = disabled)
NEXT_TELEMETRY_DISABLED=1
