# ==============================================================================
# LaunchPad SaaS OS — Production Frontend Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS TO SOURCE CONTROL!
# Copy this file to '.env.production' on your production deployment server.

# Node Environment Mode
NODE_ENV=production

# Next.js Server Port
PORT=3000

# Public API Gateway Base URL (Must match your production backend domain / SSL URL)
# Example for Render: NEXT_PUBLIC_API_URL=https://<YOUR_RENDER_SERVICE_SLUG>.onrender.com
NEXT_PUBLIC_API_URL=https://<YOUR_RENDER_SERVICE_SLUG>.onrender.com

# Telemetry Toggle (1 = disabled for privacy & compliance)
NEXT_TELEMETRY_DISABLED=1

# Optional Custom CDN / Asset Prefix
# NEXT_PUBLIC_ASSET_PREFIX=https://cdn.launchpad-os.com
