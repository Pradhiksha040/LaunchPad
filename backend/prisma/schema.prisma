generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  SUPER_ADMIN
  ORG_ADMIN
  DEVELOPER
  USER
  VIEWER
}

enum AppMode {
  STANDALONE
  INTEGRATION_HUB
}

enum AppStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

model Organization {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  industry     String?
  domain       String?
  plan         String        @default("Starter")
  status       String        @default("active")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  users        User[]
  roles        Role[]
  applications Application[]
  auditLogs    AuditLog[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  name           String
  avatar         String?
  organizationId String
  role           SystemRole   @default(USER)
  status         UserStatus   @default(ACTIVE)
  lastLogin      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs      AuditLog[]

  @@map("users")
}

model Role {
  id             String        @id @default(uuid())
  organizationId String?
  name           String
  description    String?
  permissions    Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissionsRel Permission[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid())
  roleId    String
  resource  String
  action    String
  createdAt DateTime @default(now())

  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("permissions")
}

model Template {
  id           String        @id @default(uuid())
  name         String        @unique
  industry     String
  category     String
  description  String
  popularity   Int           @default(90)
  iconName     String
  featured     Boolean       @default(false)
  modules      Json
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  applications Application[]

  @@map("templates")
}

model Application {
  id             String               @id @default(uuid())
  organizationId String
  name           String
  slug           String
  description    String
  mode           AppMode              @default(STANDALONE)
  templateId     String?
  status         AppStatus            @default(DRAFT)
  environment    String               @default("development")
  usersCount     Int                  @default(0)
  branding       Json?
  targetBackend  Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template       Template?            @relation(fields: [templateId], references: [id], onDelete: SetNull)
  modules        ApplicationModule[]
  settings       ApplicationSetting[]

  @@unique([organizationId, slug])
  @@map("applications")
}

model ApplicationModule {
  id            String      @id @default(uuid())
  applicationId String
  moduleId      String?
  name          String
  code          String
  description   String?
  category      String      @default("General")
  icon          String?
  isEnabled     Boolean     @default(true)
  isRequired    Boolean     @default(false)
  isCustom      Boolean     @default(false)
  order         Int         @default(0)
  dependencies  Json?
  visibility    Json?
  permissions   Json?
  configuration Json?
  settings      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_modules")
}

model ApplicationSetting {
  id            String      @id @default(uuid())
  applicationId String
  key           String
  value         String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, key])
  @@map("application_settings")
}

model AuditLog {
  id             String        @id @default(uuid())
  userId         String?
  organizationId String?
  action         String
  resource       String
  resourceId     String?
  status         String        @default("success")
  details        String?
  ip             String?
  userAgent      String?
  timestamp      DateTime      @default(now())

  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
