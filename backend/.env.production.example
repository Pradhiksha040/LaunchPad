# ==============================================================================
# LaunchPad SaaS OS — Production Backend Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS TO SOURCE CONTROL!
# Copy this file to 'backend/.env.production' on your production deployment server.

# Server Port
PORT=4000

# Node Environment Mode
NODE_ENV=production

# Production PostgreSQL Connection Strings (Neon Serverless PostgreSQL)
# DATABASE_URL: Pooled connection via PgBouncer (transaction mode) for NestJS runtime API traffic
# Example format: postgresql://<DB_USER>:<DB_PASSWORD>@ep-<ENDPOINT_ID>-pooler.<REGION>.aws.neon.tech/<DB_NAME>?sslmode=require
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@ep-<ENDPOINT_ID>-pooler.<REGION>.aws.neon.tech/<DB_NAME>?sslmode=require"

# DIRECT_URL: Direct TCP connection for Prisma migrations (bypasses PgBouncer for session-level DDL locks)
# Example format: postgresql://<DB_USER>:<DB_PASSWORD>@ep-<ENDPOINT_ID>.<REGION>.aws.neon.tech/<DB_NAME>?sslmode=require
DIRECT_URL="postgresql://<DB_USER>:<DB_PASSWORD>@ep-<ENDPOINT_ID>.<REGION>.aws.neon.tech/<DB_NAME>?sslmode=require"

# Cryptographically Secure JWT Secret Key (Generate with: openssl rand -base64 48)
JWT_SECRET="CHANGE_THIS_TO_COMPLEX_LONG_RANDOM_BASE64_STRING_64_CHARACTERS_MINIMUM"

# Allowed CORS Origins (Comma-separated list of exact frontend domains with HTTPS)
CORS_ORIGIN="https://app.launchpad-os.com,https://admin.launchpad-os.com"

# API Rate Limiting Thresholds
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=60000

# Stripe Monetization Credentials (Live Mode)
STRIPE_SECRET_KEY="sk_live_CHANGE_THIS_TO_YOUR_ACTUAL_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="whsec_CHANGE_THIS_TO_YOUR_ACTUAL_STRIPE_WEBHOOK_SECRET"

# Platform Revenue Share Commission (e.g., 0.15 = 15% platform fee, 85% publisher fee)
PLATFORM_COMMISSION_RATE=0.15

# Security Encryption Key for Sensitive Integration Secrets (API Keys, OAuth Tokens)
ENCRYPTION_KEY="CHANGE_THIS_TO_32_BYTE_HEX_STRING_FOR_AES_256_GCM"
