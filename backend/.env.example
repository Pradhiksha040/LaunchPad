# LaunchPad OS — Backend Environment Configuration Template

# Server Port
PORT=4000

# Node Environment Mode (development | staging | production)
NODE_ENV=development

# PostgreSQL Database Connection String (Local Development)
# Replace <DB_USER> and <DB_PASSWORD> with your local PostgreSQL credentials
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/launchpad_dev?schema=public"

# Cryptographically Secure JWT Secret Keys for User Authentication & Token Refresh
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="<CHANGE_TO_SECURE_JWT_SECRET_STRING_MIN_32_CHARS>"
JWT_REFRESH_SECRET="<CHANGE_TO_SECURE_JWT_REFRESH_SECRET_STRING_MIN_32_CHARS>"

# Encryption Key for Encrypting Integration Secrets at Rest (32-byte hex string)
ENCRYPTION_KEY="<CHANGE_TO_32_BYTE_HEX_STRING_FOR_AES_256_GCM>"

# Allowed CORS Origins (comma-separated or * for dev)
CORS_ORIGIN="http://localhost:3000,http://localhost:4000"

# Rate Limit Requests Per Minute Window
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
