# LaunchPad OS — Backend Environment Configuration Template

# Server Port
PORT=4000

# Node Environment Mode (development | staging | production)
NODE_ENV=development

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://launchpad:launchpad_password@localhost:5432/launchpad_os?schema=public"

# JWT Secret Key for User Authentication & Tokens
JWT_SECRET="launchpad_enterprise_jwt_secret_key_2026_super_secure"

# Allowed CORS Origins (comma-separated or * for dev)
CORS_ORIGIN="http://localhost:3000,http://localhost:4000"

# Rate Limit Requests Per Minute Window
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
